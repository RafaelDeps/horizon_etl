# SigPesq Credentials
SIGPESQ_USERNAME=your_username_here
SIGPESQ_PASSWORD=your_password_here

# Database
DATABASE_URL=sqlite:///db/horizon.db
STORAGE_TYPE=db
JSON_DATA_DIR=./data_json

# LGPD PII anonymization secret (REQUIRED wherever PII is handled)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER commit the real value: keep it in .env (gitignored) or a secret manager.
# Rotating it changes every anonymized token already persisted — treat as
# long-lived (see specs/001-lgpd-pii-anonymization, research.md Decision 8).
HORIZON_PII_HMAC_KEY=your_generated_secret_here

# Prefect
# Local (non-Docker): http://127.0.0.1:4200/api
# Docker Compose: overridden to http://server:4200/api by docker-compose.yml
PREFECT_API_URL=http://127.0.0.1:4200/api

# Mistral — used ONLY for extracting project documents
# (PDF -> data/exports/project_sigpesq_files_json/PJ_*.json, consumed by
# enrich_projects). The weekly pipeline does NOT need this key: it only reads the already extracted JSON.
# Leave blank if you are not going to run the extraction.
MISTRAL_KEY=your_mistral_api_key_here

# Telegram notifications (optional — leave blank to disable)
HORIZON_TELEGRAM_BOT_TOKEN=your_bot_token_here
HORIZON_TELEGRAM_CHAT_ID=your_group_chat_id_here

# Browser paths for Lattes/SigPesq (set automatically in Docker; override for local if needed)
# Docker values: CHROME_BINARY=/usr/bin/chromium  CHROMEDRIVER_PATH=/usr/bin/chromedriver
CHROME_BINARY=
CHROMEDRIVER_PATH=
